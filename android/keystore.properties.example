# Copy this file to "keystore.properties" (same folder) and fill in your real values.
# keystore.properties is git-ignored — it must NEVER be committed, since it holds the
# passwords that protect your Play Store release signing key.
#
# storeFile is a path relative to the android/app/ folder OR an absolute path — e.g.
# if you keep the .keystore file in your home folder, use something like
# /Users/yourname/heseos-partner-release.keystore
storeFile=/absolute/path/to/heseos-partner-release.keystore
storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
keyAlias=heseos-partner
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
