# Neon Postgres connection string (Vercel: add this in Project Settings > Environment Variables)
# Get it from the Neon dashboard > your project > Connection Details (use the pooled connection string).
# Without this set, the app falls back to local JSON files under /data — fine for local dev.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Session signing secret (any long random string). Falls back to a dev default when unset in development.
AUTH_SECRET=

# ── WhatsApp (Meta Cloud API) — Team Inbox + shop QR entry point ──
# Same pattern as MARG. Fill these in when you're ready to wire up the WhatsApp inbox / QR flow.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WABA_ID=
# The human-dialable business number (digits only, country code first, e.g. 919876543210).
# Used to build the wa.me QR links at /wa/<ref> — separate from WHATSAPP_PHONE_ID above.
WHATSAPP_BUSINESS_NUMBER=

# ── Meta Lead Ads (Instant Forms) webhook ──
# VERIFY_TOKEN: any string you make up — enter the same one in the Meta App dashboard's
# webhook config. ACCESS_TOKEN: a Page access token with leads_retrieval permission.
# APP_SECRET: your Meta App's "App Secret" (App Dashboard > Settings > Basic) — used to verify
# incoming webhook payloads are genuinely from Meta. Optional but recommended in production;
# the webhook accepts unsigned requests when this is left blank.
META_LEAD_VERIFY_TOKEN=
META_LEAD_ACCESS_TOKEN=
META_APP_SECRET=

PUBLIC_BASE_URL=http://localhost:3000

# ── Optional lead notifications (mirrors MARG's SETUP_LEADS.md) ──
GOOGLE_SHEET_WEBHOOK=
RESEND_API_KEY=
NOTIFY_EMAIL=
