# Neon Postgres connection string (Vercel: add this in Project Settings > Environment Variables)
# Get it from the Neon dashboard > your project > Connection Details (use the pooled connection string).
# Without this set, the app falls back to local JSON files under /data — fine for local dev.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Session signing secret (any long random string). Falls back to a dev default when unset in development.
AUTH_SECRET=

# ── Meta Lead Ads (Instant Forms) webhook ──
# VERIFY_TOKEN: any string you make up — enter the same one in the Meta App dashboard's
# webhook config. APP_SECRET: your Meta App's "App Secret" (App Dashboard > Settings > Basic)
# — used to verify incoming webhook payloads are genuinely from Meta. Optional but recommended
# in production; the webhook accepts unsigned requests when this is left blank.
META_LEAD_VERIFY_TOKEN=
META_APP_SECRET=
# ACCESS_TOKEN below is now optional — the admin can instead connect a Page and pick which
# lead forms to capture from Admin -> Settings (self-service, per-form selection, no redeploy
# needed). Leave this set as a fallback: if no Page is connected in Settings, the webhook
# still uses this token and captures every form on the Page, exactly as before.
META_LEAD_ACCESS_TOKEN=

PUBLIC_BASE_URL=http://localhost:3000

# ── Automated lead reminders (app/api/cron/lead-reminders/route.js) ──
# Any long random string — shared between this env var and the CRON_SECRET repo secret in
# .github/workflows/lead-reminders.yml (or whatever external scheduler calls this route). The
# route checks incoming requests for `Authorization: Bearer <this value>` and refuses to run
# (500) if this env var isn't set at all, so leaving it blank is safe — the cron route just
# stays inert rather than running unauthenticated.
CRON_SECRET=

# ── Optional lead notifications (mirrors MARG's SETUP_LEADS.md) ──
GOOGLE_SHEET_WEBHOOK=
RESEND_API_KEY=
NOTIFY_EMAIL=

# ── Velocity Shipping (velocity.in) — courier shipments for orders (lib/velocityShipping.js) ──
# Leave VELOCITY_API_KEY blank and the integration stays off (orders work exactly as before).
VELOCITY_API_KEY=            # Velocity dashboard -> Settings -> API Keys -> Generate API Key
VELOCITY_WAREHOUSE_ID=       # pickup warehouse id (e.g. WHYYB5), from Velocity -> Warehouses
VELOCITY_PICKUP_LOCATION=    # that warehouse's name, exactly as shown in Velocity
VELOCITY_WEBHOOK_SECRET=     # any long random string; also enter it in Velocity -> Settings -> Webhooks (API Key auth)
# VELOCITY_AUTO_SHIP=false   # uncomment to stop auto-creating a shipment when an order is marked Packed
# Parcel size sent with every order (defaults: 1 kg, 25 x 20 x 12 cm)
# VELOCITY_PKG_WEIGHT_KG=1
# VELOCITY_PKG_LENGTH_CM=25
# VELOCITY_PKG_BREADTH_CM=20
# VELOCITY_PKG_HEIGHT_CM=12
